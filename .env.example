# Database (SQLite local dev default; switch prisma provider to "postgresql" for prod)
DATABASE_URL="file:./dev.db"

# Auth.js v5
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AES-256-GCM Vault Encryption Key (32-byte hex string)
CUST0DY_VAULT_KEY="replace-with-64-hex-characters"

# Stripe Connect (Express accounts + manual capture PaymentIntents)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional Web3 Escrow RPC (USDC / SOL)
SOLANA_RPC_URL=""
USDC_ESCROW_PROGRAM_ID=""
