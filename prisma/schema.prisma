// Cust0dy Prisma Schema
// Supports SQLite out of the box for local dev; switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  alias             String   @unique // Anonymized trading desk ID (e.g., DESK_7F2A)
  role              String   @default("USER") // USER | ADMIN
  walletAddress     String?
  walletChain       String?  // ETH | SOL
  stripeConnectId   String?
  stripeOnboarded   Boolean  @default(false)
  usdcPayoutAddress String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assets             Asset[]
  orders             Order[]
  proposedSwaps      SwapOffer[]         @relation("SwapProposer")
  receivedSwaps      SwapOffer[]         @relation("SwapReceiver")
  buyerEscrows       EscrowTransaction[] @relation("EscrowBuyer")
  sellerEscrows      EscrowTransaction[] @relation("EscrowSeller")
  auditLogs          EscrowAuditLog[]
}

model Asset {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String    @unique // e.g., agent.ai, @nexus, vault.sol
  category            String    // AI_DOMAIN | TECH_DOMAIN | SOCIAL_HANDLE | WEB3_NAME
  subCategory         String    // .ai | .xyz | .io | .com | X | Telegram | ENS | .sol | Farcaster
  description         String
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])

  verificationMethod  String    // DNS_TXT | BIO_HASH
  verificationCode    String    // cust0dy-verify=c0_... or C0-8841
  verificationStatus  String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED
  verifiedAt          DateTime?
  registrarOrPlatform String    // Namecheap, Cloudflare, GoDaddy, X, Telegram, ENS, SNS, Farcaster

  swapEnabled         Boolean   @default(true)
  lowestAsk           Float?
  highestBid          Float?
  lastSalePrice       Float?
  floorDelta24h       Float     @default(0)
  sparklineData       String    @default("[]") // JSON array of { t: string, p: number }
  status              String    @default("ACTIVE") // ACTIVE | IN_ESCROW | SOLD | INVENTORY

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders              Order[]
  targetSwapOffers    SwapOffer[]         @relation("SwapTargetAsset")
  escrows             EscrowTransaction[]

  @@index([category])
  @@index([status])
  @@index([ownerId])
}

model Order {
  id        String    @id @default(cuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  side      String    // BID | ASK
  price     Float
  currency  String    @default("USD") // USD | USDC | SOL
  status    String    @default("OPEN") // OPEN | FILLED | CANCELLED
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([assetId, side, status])
  @@index([userId])
}

model SwapOffer {
  id              String             @id @default(cuid())
  targetAssetId   String
  targetAsset     Asset              @relation("SwapTargetAsset", fields: [targetAssetId], references: [id], onDelete: Cascade)
  proposerId      String
  proposer        User               @relation("SwapProposer", fields: [proposerId], references: [id])
  receiverId      String
  receiver        User               @relation("SwapReceiver", fields: [receiverId], references: [id])
  offeredAssetIds String             // JSON array of Asset IDs (1–3 verified platform assets)
  cashTopUp       Float              @default(0)
  currency        String             @default("USDC") // USD | USDC | SOL
  status          String             @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  escrow          EscrowTransaction?

  @@index([targetAssetId])
  @@index([proposerId])
  @@index([receiverId])
}

model EscrowTransaction {
  id                 String    @id @default(cuid())
  tradeCode          String    @unique // e.g., C0-ESC-8841
  type               String    // BUY_NOW | BID_ACCEPT | SWAP
  assetId            String
  asset              Asset     @relation(fields: [assetId], references: [id])
  swapOfferId        String?   @unique
  swapOffer          SwapOffer? @relation(fields: [swapOfferId], references: [id])

  buyerId            String
  buyer              User      @relation("EscrowBuyer", fields: [buyerId], references: [id])
  sellerId           String
  seller             User      @relation("EscrowSeller", fields: [sellerId], references: [id])

  assetPrice         Float     // Base agreed price (or cash top-up / assessed value for swaps)
  buyerFee           Float     // 2.5% buyer protection fee
  sellerFee          Float     // 5.0% seller fee
  totalPlatformFee   Float     // 7.5% total take rate
  totalBuyerDeposit  Float     // assetPrice + buyerFee
  sellerPayout       Float     // assetPrice - sellerFee
  currency           String    @default("USD") // USD | USDC | SOL

  paymentMethod      String    @default("STRIPE") // STRIPE | USDC_ESCROW | SOL_ESCROW
  paymentIntentId    String?   // Stripe PaymentIntent ID or on-chain escrow tx hash

  // State machine: FUNDS_LOCKED -> CUSTODY_HANDOVER -> VERIFICATION_RELEASE -> SETTLED | DISPUTED | REFUNDED
  state              String    @default("FUNDS_LOCKED")
  slaDeadline        DateTime  // 24h seller handover SLA
  inspectionDeadline DateTime? // 12h buyer inspection window

  // AES-256-GCM Encrypted Transfer Vault (Domains: EPP code; Handles: clean-room burner email + 2FA lock)
  encryptedEppCode   String?
  eppIv              String?
  eppAuthTag         String?
  burnerVaultEmail   String?
  burner2faLocked    Boolean   @default(false)

  // Dual-vault handover fields for Multi-Asset Swaps
  buyerSwapKeyDeposited Boolean @default(false)
  encryptedBuyerSwapKey String?
  buyerSwapIv           String?
  buyerSwapAuthTag      String?

  rdapVerified       Boolean   @default(false)
  disputeReason      String?
  settledAt          DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs          EscrowAuditLog[]
  feeLedger          PlatformFeeLedger?

  @@index([state])
  @@index([buyerId])
  @@index([sellerId])
}

model EscrowAuditLog {
  id        String            @id @default(cuid())
  escrowId  String
  escrow    EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?             @relation(fields: [actorId], references: [id])
  actorRole String            // BUYER | SELLER | SYSTEM | ADMIN
  action    String            // FUNDS_LOCKED | EPP_DEPOSITED | BURNER_2FA_LOCKED | RDAP_VERIFIED | SETTLED | DISPUTED | AUTO_REFUNDED | ADMIN_OVERRIDE
  details   String
  metadata  String?           // JSON string with cryptographic fingerprints / tx hashes
  createdAt DateTime          @default(now())

  @@index([escrowId])
}

model PlatformFeeLedger {
  id          String            @id @default(cuid())
  escrowId    String            @unique
  escrow      EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  grossAmount Float
  buyerFee    Float
  sellerFee   Float
  totalFee    Float
  currency    String            @default("USD")
  status      String            @default("PENDING") // PENDING | COLLECTED | REFUNDED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}
